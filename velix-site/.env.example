# Copy this file to .env and fill in your own EmailJS credentials.
# 1. Create a free account at https://www.emailjs.com
# 2. Add an Email Service (e.g. Gmail) - copy its Service ID
# 3. Create a template that notifies you of new submissions - copy its Template ID
# 4. Create a second template that confirms receipt to the sender - copy its Template ID
# 5. Copy your Public Key from Account > General
VITE_EMAILJS_SERVICE_ID=service_xxxxxxx
VITE_EMAILJS_TEMPLATE_ADMIN=template_xxxxxxx
VITE_EMAILJS_TEMPLATE_CONFIRM=template_xxxxxxx
VITE_EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxx
